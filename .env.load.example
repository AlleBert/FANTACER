# Env per l'app di load test (Docker, server casa).
# Copiare in .env.load (gitignored) e compilare con le credenziali di fantacer-e2e.
#
# Le NEXT_PUBLIC_* servono DUE volte:
#   1. come --build-arg (sono inlined nel bundle a build-time);
#   2. a runtime server-side (src/lib/supabase/admin.ts, src/proxy.ts).
# Per semplicita' tenerle in questo file e usare `set -a; source .env.load; set +a`
# sia per la build sia per `docker run --env-file .env.load`.

NEXT_PUBLIC_SUPABASE_URL=https://ookipybsnjtvdrzqzpsl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<e2e-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<e2e-service-role-key>

# TURNSTILE_SECRET_KEY volutamente ASSENTE:
# senza secret il server bypassa la verifica Turnstile (src/app/api/vota/route.ts:11).
# Non rimetterlo: k6 e il mini-run non possono generare token reali.
