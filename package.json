{
  "name": "fantacer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:tunnel": "node scripts/dev-with-tunnel.mjs",
    "setup:tunnel": "node scripts/install-cloudflared.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=2560 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --maxWorkers=4",
    "test:watch": "jest --watch --maxWorkers=4",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:gate": "NODE_OPTIONS=--max-old-space-size=2560 playwright test tests/e2e/responsive-structural.spec.ts tests/e2e/voting-flow.spec.ts --project=chromium --project=mobile-webkit --workers=1",
    "e2e:home": "NODE_OPTIONS=--max-old-space-size=2560 playwright test tests/e2e/homepage.spec.ts tests/e2e/legal-pages.spec.ts tests/e2e/smoke.spec.ts tests/e2e/scroll-blocking.spec.ts tests/e2e/accessibility.spec.ts --project=chromium --workers=1",
    "e2e:admin": "NODE_OPTIONS=--max-old-space-size=2560 playwright test tests/e2e/admin-auth.spec.ts tests/e2e/admin.spec.ts tests/e2e/admin-sponsor.spec.ts tests/e2e/viewer.spec.ts tests/e2e/repro-phantom-500.spec.ts --project=chromium --workers=1",
    "e2e:phantom-admin": "NODE_OPTIONS=--max-old-space-size=2560 playwright test tests/e2e/phantom-500-admin.spec.ts --project=mobile-webkit --workers=1",
    "e2e:cleanup": "bash scripts/kill-browsers.sh",
    "provision:e2e:admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/provision-e2e-admin.mjs",
    "provision:e2e:admin:test": "node --env-file-if-exists=.env.e2e scripts/provision-e2e-admin.mjs --env-file=.env.e2e",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true NODE_OPTIONS=--max-old-space-size=2560 next build --webpack",
    "perf:report": "node scripts/perf-audit.mjs",
    "lighthouse": "lhci autorun",
    "ui:health": "npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "visual:audit": "playwright test tests/e2e/visual-audit.spec.ts --project=chromium --workers=1",
    "visual:audit:admin": "playwright test tests/e2e/visual-audit-admin-only.spec.ts --project=chromium --workers=1",
    "visual:audit:homepage": "playwright test tests/e2e/visual-audit-homepage.spec.ts --project=chromium --workers=1",
    "visual:audit:ios": "playwright test tests/e2e/visual-audit-homepage-ios.spec.ts --project=ios-se --project=ios-iphone --project=ios-pro-max --project=ios-ipad-portrait --workers=1",
    "visual:audit:ios:safearea": "VISUAL_IOS_MODAL=1 playwright test tests/e2e/visual-audit-homepage-ios-safearea.spec.ts --project=ios-se --project=ios-iphone --project=ios-pro-max --project=ios-ipad-portrait --workers=1",
    "visual:audit:ios:chrome": "VISUAL_IOS_MODAL=1 playwright test tests/e2e/visual-audit-homepage-ios-chrome.spec.ts --project=ios-se --project=ios-iphone --project=ios-pro-max --project=ios-ipad-portrait --workers=1",
    "visual:audit:summary": "node scripts/generate-audit-summary.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fingerprintjs/botd": "^2.0.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource/open-sauce-one": "^5.2.5",
    "@marsidev/react-turnstile": "^1.5.1",
    "@next/third-parties": "^16.3.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-table": "^8.21.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.59.1",
    "@sentry/nextjs": "^10.67.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^29.1.1",
    "qrcode-terminal": "^0.12.0",
    "react-scan": "^0.5.7",
    "shadcn": "^4.3.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
